# Copy to .env.local. All optional: without them STILL runs fully on-device in demo mode.

# App (public by design; row-level security protects the data)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-or-anon-key

# Edge Function secrets: set with `npx supabase secrets set ...`, never in the app
# GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-3.5-flash-lite
# COACH_REQUESTS_PER_HOUR=20
